+def findall_slices(substr: str, in_str: str) -> Iterator[slice]:
+    """Yields a slice of in_str for each occurrence of substr.
+
+    >>> list(findall_slices("ab", "abcab"))
+    [slice(0, 2, None), slice(3, 5, None)]
+    """
+    for idx in findall(substr, in_str):
+        yield slice(idx, idx + len(substr))
