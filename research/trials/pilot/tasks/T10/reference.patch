+def format_violations(violations: list[dict[str, Any]]) -> str:
+    """Render violations (as returned by `lint`) as plain text, one per line."""
+    lines = []
+    for v in violations:
+        desc = v["description"]
+        if v.get("name"):
+            desc += f" [{v['name']}]"
+        lines.append(
+            f"L:{v['start_line_no']:4d} | P:{v['start_line_pos']:4d} | "
+            f"{v['code'].rjust(4)} | {desc}"
+        )
+    return "\n".join(lines)
+
