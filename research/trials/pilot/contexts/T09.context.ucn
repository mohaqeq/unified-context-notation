convention ClickOnlyInCli: click is used only by the CLI and its test helpers
  check: only sqlfluff/{cli,utils/testing}/** imports click
container Package
  component Api: public Python API
    code: sqlfluff/api/**
    forbids Cli
  component Cli: command-line interface
    code: sqlfluff/cli/**
  component Dialects: SQL dialect definitions
    code: sqlfluff/dialects/**
  component Rules: linting rules
    code: sqlfluff/rules/**
    forbids Dialects
  component Utils: shared utilities for rules and reflow
    code: sqlfluff/utils/**
    forbids Dialects
  component Core: parser, lexer, config infrastructure
    code: sqlfluff/core/**
