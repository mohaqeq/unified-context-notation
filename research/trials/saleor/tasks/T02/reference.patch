+def delete_dormant_customers(cutoff: datetime.datetime) -> int:
+    """Delete customers that have been inactive since ``cutoff``.
+
+    A customer is dormant when they are not staff, have never placed an order and
+    either last logged in before ``cutoff`` or never logged in and joined before it.
+    Return the number of deleted customers.
+    """
+    dormant_customers = (
+        User.objects.filter(is_staff=False)
+        .filter(
+            Q(last_login__lt=cutoff)
+            | Q(last_login__isnull=True, date_joined__lt=cutoff)
+        )
+        .filter(~Exists(Order.objects.filter(user_id=OuterRef("pk"))))
+    )
+    with traced_atomic_transaction():
+        user_pks = list(dormant_customers.values_list("pk", flat=True))
+        users = User.objects.filter(pk__in=user_pks)
+        # GiftCard.assigned_to is PROTECT: restricted cards are detached and
+        # deactivated together with the deletion.
+        deactivate_assigned_gift_cards(users)
+        delete_user_unique_attribute_values(user_pks)
+        users.delete()
+    return len(user_pks)
