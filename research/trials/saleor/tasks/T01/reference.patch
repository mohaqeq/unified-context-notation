+import datetime
+
 from ...giftcard import models
 from ..core.context import get_database_connection_name
 
 
+def resolve_gift_card_balance(info, code):
+    today = datetime.datetime.now(tz=datetime.UTC).date()
+    gift_card = (
+        models.GiftCard.objects.using(get_database_connection_name(info.context))
+        .active(date=today)
+        .filter(code=code)
+        .first()
+    )
+    if gift_card is None:
+        return None
+    user = info.context.user
+    # A card restricted to a customer is reported exactly like an unknown code.
+    if gift_card.usage_restriction_reason(user.pk if user else None):
+        return None
+    return gift_card.current_balance
+
