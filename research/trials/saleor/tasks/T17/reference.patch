+    @staticmethod
+    def move_children_to_parent(instance: models.MenuItem):
+        """Move the direct children of the item to the item's parent.
+
+        Every move renumbers the tree, and mptt computes a move from the in-memory
+        values of the moved node and of the target, so both are read again from the
+        database right before each move.
+        """
+        instance._mptt_refresh()
+        new_parent_id = instance.parent_id
+        child_ids = list(
+            models.MenuItem.objects.filter(parent_id=instance.pk)
+            .order_by("lft")
+            .values_list("pk", flat=True)
+        )
+        for child_id in child_ids:
+            child = models.MenuItem.objects.get(pk=child_id)
+            child.parent = (
+                models.MenuItem.objects.get(pk=new_parent_id) if new_parent_id else None
+            )
+            child.sort_order = None
+            child.save()
