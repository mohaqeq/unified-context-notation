+def retry_event_deliveries(deliveries: Sequence[EventDelivery]) -> None:
+    """Put the deliveries back to `PENDING` and schedule sending them again.
+
+    The status is changed with a single query, regardless of the number of
+    deliveries. Expects the deliveries loaded with `webhook` and `webhook__app`.
+    """
+    if not deliveries:
+        return
+    EventDelivery.objects.filter(pk__in=[delivery.pk for delivery in deliveries]).update(
+        status=EventDeliveryStatus.PENDING
+    )
+    domain = get_domain()
+    telemetry_context = get_task_context().to_dict()
+    for delivery in deliveries:
+        webhook = delivery.webhook
+        send_webhook_request_async.apply_async(
+            kwargs={
+                "event_delivery_id": delivery.pk,
+                "telemetry_context": telemetry_context,
+            },
+            queue=get_queue_name_for_webhook(
+                webhook, default_queue=settings.WEBHOOK_CELERY_QUEUE_NAME
+            ),
+            MessageGroupId=get_sqs_message_group_id(domain, webhook.app),
+        )
+
