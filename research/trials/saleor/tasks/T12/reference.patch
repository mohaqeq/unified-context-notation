@@ -0,0 +1,63 @@
+import graphene
+from django.core.exceptions import ValidationError
+from django.db.models import Exists, OuterRef
+
+from ....app.models import App
+from ....core import models
+from ....permission.enums import AppPermission
+from ....webhook.error_codes import WebhookErrorCode
+from ....webhook.models import Webhook
+from ....webhook.transport.asynchronous.transport import retry_event_deliveries
+from ...core import ResolveInfo
+from ...core.descriptions import ADDED_IN_324
+from ...core.doc_category import DOC_CATEGORY_WEBHOOKS
+from ...core.mutations import BaseMutation
+from ...core.types import NonNullList, WebhookError
+from ..types import EventDelivery
+
+
+class EventDeliveryBulkRetry(BaseMutation):
+    count = graphene.Int(
+        required=True,
+        description="Number of event deliveries scheduled for another attempt.",
+    )
+
+    class Arguments:
+        ids = NonNullList(
+            graphene.ID,
+            required=True,
+            description="IDs of the event deliveries to retry.",
+        )
+
+    class Meta:
+        description = "Retries multiple event deliveries." + ADDED_IN_324
+        doc_category = DOC_CATEGORY_WEBHOOKS
+        permissions = (AppPermission.MANAGE_APPS,)
+        error_type_class = WebhookError
+
+    @classmethod
+    def handle_errors(cls, error, **extra):
+        return super().handle_errors(error, count=0, **extra)
+
+    @classmethod
+    def perform_mutation(cls, _root, info: ResolveInfo, /, **data):
+        apps = App.objects.filter(removed_at__isnull=True).values("pk")
+        webhooks = Webhook.objects.filter(
+            Exists(apps.filter(id=OuterRef("app_id")))
+        ).values("pk")
+        qs = models.EventDelivery.objects.filter(
+            Exists(webhooks.filter(id=OuterRef("webhook_id")))
+        ).select_related("webhook__app")
+        pks = cls.get_global_ids_or_error(data["ids"], EventDelivery, field="ids")
+        deliveries = list(qs.filter(pk__in=pks))
+        if len(deliveries) != len(set(pks)):
+            raise ValidationError(
+                {
+                    "ids": ValidationError(
+                        "Couldn't resolve all event deliveries.",
+                        code=WebhookErrorCode.NOT_FOUND.value,
+                    )
+                }
+            )
+        retry_event_deliveries(deliveries)
+        return EventDeliveryBulkRetry(count=len(deliveries))
