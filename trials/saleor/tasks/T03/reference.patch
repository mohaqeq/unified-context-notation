         | Q(used_by=user)
         | Q(created_by=user)
     )
+
+
+def adjust_gift_card_balances(
+    gift_card_pks: Iterable[int],
+    amount: Decimal,
+    user: Optional["User"],
+    app: Optional["App"],
+) -> list[GiftCard]:
+    """Adjust the balance of the given gift cards by a signed delta.
+
+    All cards are locked in primary-key order for the duration of the transaction.
+    A deduction below zero clamps the balance to zero; a top-up above the initial
+    balance raises the initial balance to the new current balance.
+    """
+    with traced_atomic_transaction():
+        locked_cards = list(gift_card_qs_select_for_update().filter(pk__in=gift_card_pks))
+        for locked in locked_cards:
+            old_current = locked.current_balance_amount
+            old_initial = locked.initial_balance_amount
+            new_current = max(old_current + amount, Decimal(0))
+            locked.current_balance_amount = new_current
+            update_fields = ["current_balance_amount"]
+            if new_current > old_initial:
+                locked.initial_balance_amount = new_current
+                update_fields.append("initial_balance_amount")
+            locked.save(update_fields=update_fields)
+            events.gift_card_balance_adjusted_event(
+                locked, old_current, old_initial, user, app
+            )
+    return locked_cards
