+from django.contrib.sites.models import Site
+from django.core.management.base import BaseCommand, CommandError
+
+from ...utils import create_site
+
+
+class Command(BaseCommand):
+    help = "Create a new site (tenant) with default settings."
+
+    def add_arguments(self, parser):
+        parser.add_argument("domain", help="Domain of the new site.")
+        parser.add_argument("name", help="Display name of the new site.")
+
+    def handle(self, *args, **options):
+        domain = options["domain"]
+        if Site.objects.filter(domain__iexact=domain).exists():
+            raise CommandError(f"A site with the domain {domain} already exists.")
+        site = create_site(domain, options["name"])
+        self.stdout.write(f"Created site {site.domain} (id: {site.pk}).")
