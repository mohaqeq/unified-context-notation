+    def get_noqa_comments(self) -> list[BaseSegment]:
+        """Find the comments below this segment which hold a noqa directive."""
+        found: list[BaseSegment] = []
+        for comment in self.recursive_crawl("comment"):
+            if not comment.is_type("inline_comment", "block_comment"):
+                continue
+            content = cast(Any, comment).raw_trimmed().strip()
+            if content.endswith("*/"):
+                content = content[:-2].rstrip()
+            if content.startswith("/*"):
+                content = content[2:].lstrip()
+            # Comments can be chained e.g. `-- some text -- noqa: LT05`.
+            if content.split("--")[-1].strip().startswith("noqa"):
+                found.append(comment)
+        return found
+
