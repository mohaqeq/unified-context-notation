+def parse_dotted_assignments(raw: str) -> dict[str, Any]:
+    """Parse comma separated `dotted.key=value` pairs into a nested dict.
+
+    >>> parse_dotted_assignments("a.b=1, c=2")
+    {'a': {'b': '1'}, 'c': '2'}
+    >>> parse_dotted_assignments("")
+    {}
+    """
+    result: dict[str, Any] = {}
+    for pair in split_comma_separated_string(raw):
+        key, sep, value = pair.partition("=")
+        if not sep:
+            raise ValueError(f"Missing '=' in assignment: {pair!r}")
+        parts = [k.strip() for k in key.split(".")]
+        if not all(parts):
+            raise ValueError(f"Invalid key in assignment: {pair!r}")
+        node = result
+        for part in parts[:-1]:
+            node = node.setdefault(part, {})
+        node[parts[-1]] = value.strip()
+    return result
